{
  "name": "rootmapmvp1.1",
  "description": "RootMap MVP is a parent-facing Montessori companion for tracking a child’s learning, weekly activities, and meaningful growth moments.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:beta-guest": "VITE_ROOTMAP_CLOUD=off VITE_SUPABASE_URL= VITE_SUPABASE_PUBLISHABLE_KEY= VITE_TURNSTILE_SITE_KEY= vite build --mode staging",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import ./tests/loader.mjs --test \"tests/unit/*.test.ts\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:cloud": "node tests/e2e/cloud.mjs && node tests/e2e/spaces.mjs && node tests/e2e/sync.mjs && node tests/e2e/guestImport.mjs && node tests/e2e/analytics.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "node --import ./tests/loader.mjs --test --test-concurrency=1 \"tests/db/*.test.ts\""
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "pg": "^8.23.1",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
