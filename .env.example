# RootMap client environment. Copy the block you need into a git-ignored file:
#
#   .env.development.local   used by `npm run dev`             (environment "local")
#   .env.staging.local       used by `npm run dev:staging` and
#                            `npm run build:staging`           (environment "staging")
#
# Without these variables the app is local-only, exactly as before. The public website build
# (`npm run build`, GitHub Pages) never enables cloud features; vite.config.ts refuses to build if asked to.
#
# Only the PUBLISHABLE key (sb_publishable_… or the legacy anon key) may appear here. Everything prefixed
# VITE_ ends up in the browser. A secret / service_role key makes the dev server and the build stop.

# "on" enables cloud features for this environment; anything else (or unset) leaves them off.
VITE_ROOTMAP_CLOUD=off

# Local stack (`npm run db:start`; values from `npx supabase status`). Must be localhost / 127.0.0.1.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Staging (in .env.staging.local): https://<project-ref>.supabase.co and that project's publishable key.

# Open beta (staging only): the Cloudflare Turnstile SITE key (public). Set this before turning on CAPTCHA protection
# in Supabase Auth, which holds the matching SECRET key. Leave it out and no CAPTCHA is shown.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
